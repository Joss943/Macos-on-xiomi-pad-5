diff --git a/test_plain_vtables.py b/test_plain_vtables.py
new file mode 100644
index 0000000..1436365
--- /dev/null
+++ b/test_plain_vtables.py
@@ -0,0 +1,47 @@
+import unittest
+from types import SimpleNamespace
+
+from fileset_match import plain_vtable_slots, reference_vtable_layouts, vtable_slots
+
+CODE = range(0x1000, 0x2000)
+
+
+def side(table_at, targets, names, auth=None, layouts=None):
+    fixups = {}
+    for index, target in enumerate(targets):
+        fixups[table_at + 16 + 8 * index] = (target,) + (auth[index] if auth else (0, None, None, None))
+    return SimpleNamespace(fixups=fixups, symbol_names={table_at: set(names)},
+                           in_exec=lambda address: address in CODE, plain_layouts=layouts)
+
+
+class PlainVtableTests(unittest.TestCase):
+    layout = ((1, 0, 0x1111, 1), (1, 0, 0x2222, 1))
+
+    def test_reference_layout_is_borrowed_for_same_named_complete_table(self):
+        reference = side(0x8000, [0x1100, 0x1200], ['__ZTV7IOThing'], auth=self.layout)
+        layouts = reference_vtable_layouts(reference)
+        self.assertEqual(layouts, {'__ZTV7IOThing': self.layout})
+        native = side(0x9000, [0x1300, 0x1400], ['__ZTV7IOThing'], layouts=layouts)
+        self.assertEqual(vtable_slots(native, 0x9000), [(0x1300,) + self.layout[0], (0x1400,) + self.layout[1]])
+
+    def test_different_extent_or_unknown_name_gives_no_layout(self):
+        layouts = {'__ZTV7IOThing': self.layout}
+        longer = side(0x9000, [0x1300, 0x1400, 0x1500], ['__ZTV7IOThing'], layouts=layouts)
+        self.assertEqual(plain_vtable_slots(longer, 0x9000), [])
+        other = side(0x9000, [0x1300, 0x1400], ['__ZTV5Other'], layouts=layouts)
+        self.assertEqual(plain_vtable_slots(other, 0x9000), [])
+
+    def test_authenticated_pointer_is_not_a_plain_slot(self):
+        native = side(0x9000, [0x1300, 0x1400], ['__ZTV7IOThing'], auth=self.layout,
+                      layouts={'__ZTV7IOThing': self.layout})
+        self.assertEqual(plain_vtable_slots(native, 0x9000), [])
+
+    def test_conflicting_reference_layouts_are_dropped(self):
+        reference = side(0x8000, [0x1100, 0x1200], ['__ZTV1A'], auth=self.layout)
+        reference.fixups.update({0x8100 + 16: (0x1100, 1, 0, 0x3333, 1), 0x8100 + 24: (0x1200, 1, 0, 0x4444, 1)})
+        reference.symbol_names[0x8100] = {'__ZTV1A'}
+        self.assertEqual(reference_vtable_layouts(reference), {})
+
+
+if __name__ == '__main__':
+    unittest.main()
