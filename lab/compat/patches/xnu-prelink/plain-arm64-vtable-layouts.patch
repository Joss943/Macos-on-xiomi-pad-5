@@ -35,6 +37,52 @@ def vtable_slots(side, base):
     return []  # unterminated, so no proven table extent
 
 
+def plain_vtable_slots(side, base):
+    """Slots of a plain arm64 (no PAC) table, with the PAC layout of the same-named
+    table in a symbol-bearing arm64e reference built from the same XNU sources.
+
+    The table must end where the reference table ends (first non-code pointer)
+    and carry the same symbol; otherwise no layout is proven and the table is
+    skipped, so every later layout comparison keeps its full strength.
+    """
+    result = []
+    for offset in range(16, 8192, 8):
+        pointer = side.fixups.get(base + offset)
+        if not pointer or pointer[1] or not side.in_exec(pointer[0]):
+            break
+        result.append(pointer)
+    else:
+        return []
+    layouts = {side.plain_layouts[name] for name in side.symbol_names.get(base, ())
+               if name.startswith('__ZTV') and name in side.plain_layouts}
+    if len(layouts) != 1:
+        return []
+    layout = next(iter(layouts))
+    if len(layout) != len(result):
+        return []
+    return [(pointer[0],) + slot for pointer, slot in zip(result, layout)]
+
+
+def reference_vtable_layouts(reference):
+    """__ZTV name -> PAC layout of each complete table in an arm64e reference."""
+    layouts, ambiguous = {}, set()
+    for address, names in reference.symbol_names.items():
+        tables = [name for name in names if name.startswith('__ZTV')]
+        if not tables:
+            continue
+        slots = vtable_slots(reference, address)
+        if len(slots) < 2:
+            continue
+        layout = tuple(pointer[1:] for pointer in slots)
+        for name in tables:
+            if layouts.get(name, layout) != layout:
+                ambiguous.add(name)
+            layouts[name] = layout
+    for name in ambiguous:
+        layouts.pop(name)
+    return layouts
+
