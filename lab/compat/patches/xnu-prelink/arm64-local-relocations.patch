+    def local_relocations(self):
+        """Classic LC_DYSYMTAB local relocations of a plain arm64 kernel.
+
+        ld emits these instead of chained fixups when it links arm64 (not
+        arm64e) with -static -pie: one ARM64_RELOC_UNSIGNED, 64-bit, non-extern,
+        non-pc-relative record per rebased pointer, r_address relative to the
+        first segment. Anything else is refused rather than guessed.
+        Returns site va -> stored pointer value (the unslid target va).
+        """
+        found = self.command(LC_DYSYMTAB)
+        if not found:
+            return {}
+        locreloff, nlocrel = struct.unpack_from('<II', self.data, found[0] + 72)
+        if not nlocrel:
+            return {}
+        if self.at:
+            raise ValueError('Local relocations are only read from a standalone image')
+        base = self.segments[0]['va']
+        result = {}
+        for index in range(nlocrel):
+            address, packed = struct.unpack_from('<iI', self.data, locreloff + 8 * index)
+            if address < 0:
+                raise ValueError('Scattered local relocations are not supported')
+            pcrel, length, extern, kind = (packed >> 24) & 1, (packed >> 25) & 3, (packed >> 27) & 1, packed >> 28
+            if (pcrel, length, extern, kind) != (0, 3, 0, 0):
+                raise ValueError(f'Unsupported local relocation shape pcrel={pcrel} length={length} '
+                                 f'extern={extern} type={kind}')
+            site = base + address
+            if site in result:
+                raise ValueError(f'Duplicate local relocation at {site:#x}')
+            result[site] = int.from_bytes(self.read(site, 8), 'little')
+        return result
+
     def fixups(self):
-        """Chained fixups: site va -> (target va, auth, key, diversity, address diversity)."""
+        """Chained fixups: site va -> (target va, auth, key, diversity, address diversity).
+
+        Without LC_DYLD_CHAINED_FIXUPS, classic local relocations are reported in
+        the same shape as plain (non-authenticated) rebases.
+        """
         found = self.command(LC_DYLD_CHAINED_FIXUPS)
         if not found:
+            if self.kind == 2:   # MH_EXECUTE: a kernel linked without chained fixups
+                local = self.local_relocations()
+                if local and not all(self.mapped_va(target) for target in local.values()):
+                    raise ValueError('Local relocation target outside the image')
+                return {site: (target, 0, None, None, None) for site, target in local.items()}
             return {}
         dataoff, _ = struct.unpack_from('<II', self.data, found[0] + 8)
         _, starts_offset, _, _, imports, _, _ = struct.unpack_from('<7I', self.data, dataoff)
diff --git a/test_kc_image_local_relocations.py b/test_kc_image_local_relocations.py
new file mode 100644
index 0000000..04bee7e
--- /dev/null
+++ b/test_kc_image_local_relocations.py
@@ -0,0 +1,52 @@
+import struct
+import unittest
+
+from kc_image import Image
+
+BASE = 0xfffffe0007004000
+
+
+def image(relocations, pointers):
+    """MH_EXECUTE: one segment mapping the file at BASE, pointers at file 0x1000 + offset."""
+    data_off, rel_off = 0x1000, 0x2000
+    seg = struct.pack('<II16sQQQQIIII', 0x19, 72, b'__TEXT'.ljust(16, b'\0'),
+                      BASE, 0x3000, 0, 0x3000, 3, 3, 0, 0)
+    dysymtab = struct.pack('<20I', 0xb, 80, *([0] * 16), rel_off, len(relocations))
+    commands = seg + dysymtab
+    header = struct.pack('<8I', 0xfeedfacf, 0x100000c, 0, 2, 2, len(commands), 0, 0)
+    data = bytearray(0x3000)
+    data[:32 + len(commands)] = header + commands
+    for offset, value in pointers.items():
+        struct.pack_into('<Q', data, data_off + offset, value)
+    for index, (address, packed) in enumerate(relocations):
+        struct.pack_into('<iI', data, rel_off + 8 * index, data_off + address, packed)
+    return Image(bytes(data))
+
+
+UNSIGNED_64 = 3 << 25          # length=3 (8 bytes), pcrel=0, extern=0, type=ARM64_RELOC_UNSIGNED
+
+
+class LocalRelocationTests(unittest.TestCase):
+    def test_unsigned_pointers_become_plain_fixups(self):
+        img = image([(0x10, UNSIGNED_64), (0x20, UNSIGNED_64)], {0x10: BASE + 0x100, 0x20: BASE + 0x200})
+        self.assertEqual(img.fixups(), {BASE + 0x1010: (BASE + 0x100, 0, None, None, None),
+                                        BASE + 0x1020: (BASE + 0x200, 0, None, None, None)})
+
+    def test_other_shapes_are_refused(self):
+        for packed in (UNSIGNED_64 | 1 << 24, 2 << 25, UNSIGNED_64 | 1 << 27, UNSIGNED_64 | 1 << 28):
+            with self.subTest(packed=hex(packed)):
+                with self.assertRaises(ValueError):
+                    image([(0x10, packed)], {0x10: BASE}).fixups()
+
+    def test_duplicate_and_out_of_image_targets_are_refused(self):
+        with self.assertRaises(ValueError):
+            image([(0x10, UNSIGNED_64)] * 2, {0x10: BASE}).fixups()
+        with self.assertRaises(ValueError):
+            image([(0x10, UNSIGNED_64)], {0x10: 0x1234}).fixups()
+
+    def test_no_relocations_no_fixups(self):
+        self.assertEqual(image([], {}).fixups(), {})
+
+
+if __name__ == '__main__':
+    unittest.main()
