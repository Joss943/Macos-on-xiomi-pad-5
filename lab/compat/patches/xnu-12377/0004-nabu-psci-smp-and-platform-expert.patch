+++ b/iokit/Kernel/arm/NabuPlatformExpert.cpp
@@ -0,0 +1,82 @@
+/*
+ * Minimal device-tree platform expert for Xiaomi Pad 5 (nabu).
+ * This preserves the CPU topology and real device nodes; peripheral drivers
+ * are still provided by separate XNU driver work.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(NABU)
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/IOLib.h>
+
+class NabuPlatformExpert : public IODTPlatformExpert {
+	OSDeclareDefaultStructors(NabuPlatformExpert);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void processTopLevel(IORegistryEntry *rootEntry) APPLE_KEXT_OVERRIDE;
+	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
+	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
+	bool getTargetName(char *name, int maxLength) APPLE_KEXT_OVERRIDE;
+	bool getProductName(char *name, int maxLength) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(NabuPlatformExpert, IODTPlatformExpert);
+
+bool
+NabuPlatformExpert::start(IOService *provider)
+{
+	IOLog("NABU: starting device-tree platform expert\n");
+	if (!IODTPlatformExpert::start(provider)) {
+		return false;
+	}
+	registerService();
+	IOLog("NABU: platform expert registered\n");
+	return true;
+}
+
+const char *
+NabuPlatformExpert::deleteList(void)
+{
+	return "()";
+}
+
+const char *
+NabuPlatformExpert::excludeList(void)
+{
+	return "('chosen', 'defaults', 'cpus', 'options')";
+}
+
+void
+NabuPlatformExpert::processTopLevel(IORegistryEntry *rootEntry)
+{
+	/* XNU assigns logical-cpu-id properties when it creates the CPU nubs. */
+	IORegistryEntry *cpus = rootEntry->childFromPath("cpus", gIODTPlane);
+	if (cpus != NULL) {
+		createNubs(this, IODTFindMatchingEntries(cpus, kIODTExclusive, NULL));
+		cpus->release();
+	}
+	createNubs(this, IODTFindMatchingEntries(rootEntry, kIODTExclusive, excludeList()));
+}
+
+bool
+NabuPlatformExpert::getTargetName(char *name, int maxLength)
+{
+	if (name == NULL || maxLength <= 0) {
+		return false;
+	}
+	strlcpy(name, "nabu", (size_t)maxLength);
+	return true;
+}
+
+bool
+NabuPlatformExpert::getProductName(char *name, int maxLength)
+{
+	if (name == NULL || maxLength <= 0) {
+		return false;
+	}
+	strlcpy(name, "Xiaomi Pad 5", (size_t)maxLength);
+	return true;
+}
+#endif /* NABU */
