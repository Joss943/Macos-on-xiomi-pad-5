diff --git a/iokit/Kernel/arm/NabuCPU.cpp b/iokit/Kernel/arm/NabuCPU.cpp
new file mode 100644
index 00000000..76ed7b21
--- /dev/null
+++ b/iokit/Kernel/arm/NabuCPU.cpp
@@ -0,0 +1,254 @@
+/*
+ * PSCI CPU startup and GICv3 SGI transport for Xiaomi Pad 5 (nabu).
+ * CPU power-off, suspend and platform idle policy are not implemented yet.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(NABU)
+#include <IOKit/IOCPU.h>
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSNumber.h>
+#include <kern/clock.h>
+#include <kern/processor.h>
+#include <kern/thread.h>
+#include <mach/mach_time.h>
+#include <pexpert/pexpert.h>
+
+/* Barrier domains; the osfmk names are not exported to IOKit sources. */
+enum : uint32_t { kNabuISB_SY = 0xF, kNabuDSB_SY = 0xF, kNabuDSB_ISHST = 0xA };
+
+extern "C" void nabu_secondary_entry(void);
+extern "C" boolean_t nabu_cpu_signal_is_enabled(unsigned int cpu);
+
+class NabuCPU : public IOCPU {
+	OSDeclareDefaultStructors(NabuCPU);
+	const OSSymbol *cpuName = NULL;
+	uint32_t nabuStarted = 0;
+
+public:
+	static void startAll(void *arg, wait_result_t result);
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	void initCPU(bool boot) APPLE_KEXT_OVERRIDE;
+	void quiesceCPU(void) APPLE_KEXT_OVERRIDE;
+	kern_return_t startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr) APPLE_KEXT_OVERRIDE;
+	void haltCPU(void) APPLE_KEXT_OVERRIDE;
+	void signalCPU(IOCPU *target) APPLE_KEXT_OVERRIDE;
+	const OSSymbol *getCPUName(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(NabuCPU, IOCPU);
+
+static NabuCPU *nabu_cpus[MAX_CPUS];
+static uint32_t nabu_cpus_registered;
+
+/* PSCI 0.2+ CPU_ON64, exposed by the SM8150 firmware through SMC. */
+static int32_t
+nabu_psci_cpu_on(uint64_t target, uint64_t entry, uint64_t context)
+{
+	register uint64_t x0 __asm__("x0") = 0xC4000003ULL;
+	register uint64_t x1 __asm__("x1") = target;
+	register uint64_t x2 __asm__("x2") = entry;
+	register uint64_t x3 __asm__("x3") = context;
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int32_t)x0;
+}
+
+bool
+NabuCPU::start(IOService *provider)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	OSNumber *logical = OSDynamicCast(OSNumber, provider->getProperty("logical-cpu-id"));
+	if (logical == NULL || logical->unsigned32BitValue() >= topology->num_cpus) {
+		return false;
+	}
+	const ml_topology_cpu_t *cpu = &topology->cpus[logical->unsigned32BitValue()];
+	if ((cpu->phys_id & 0xff) != 0 || cpu->phys_id > 0x700) {
+		IOLog("NABU CPU: ignoring unsupported MPIDR 0x%x\n", cpu->phys_id);
+		return false;
+	}
+	if (!IOCPU::start(provider)) {
+		return false;
+	}
+	cpuName = OSSymbol::withCStringNoCopy("Kryo 485");
+	if (cpuName == NULL) {
+		return false;
+	}
+	setCPUNumber(cpu->cpu_id);
+
+	ml_processor_info_t info = {};
+	info.cpu_id = reinterpret_cast<cpu_id_t>(this);
+	info.phys_id = cpu->phys_id;
+	info.log_id = cpu->cpu_id;
+	info.cluster_id = cpu->cluster_id;
+	info.cluster_type = cpu->cluster_type;
+	info.l2_cache_id = cpu->l2_cache_id;
+	info.l2_cache_size = cpu->l2_cache_size;
+	info.l3_cache_id = cpu->l3_cache_id;
+	info.l3_cache_size = cpu->l3_cache_size;
+	perfmon_interrupt_handler_func pmi_handler = NULL;
+	kern_return_t result = ml_processor_register(&info, &machProcessor, &ipi_handler, &pmi_handler);
+	if (result != KERN_SUCCESS) {
+		panic("NABU CPU: ml_processor_register cpu=%u failed: %d", cpu->cpu_id, result);
+	}
+	if (pmi_handler != NULL) {
+		IOLog("NABU CPU: cpu=%u PMI routing unavailable; performance interrupts disabled\n",
+		    cpu->cpu_id);
+	}
+
+	registerService();
+	__atomic_store_n(&nabu_cpus[cpu->cpu_id], this, __ATOMIC_RELEASE);
+	uint32_t registered = __atomic_add_fetch(&nabu_cpus_registered, 1, __ATOMIC_ACQ_REL);
+	if (registered > topology->num_cpus) {
+		panic("NABU CPU: duplicate CPU nub registration");
+	}
+	if (cpu == topology->boot_cpu) {
+		thread_t thread;
+		result = kernel_thread_start(&NabuCPU::startAll, NULL, &thread);
+		if (result != KERN_SUCCESS) {
+			panic("NABU CPU: cannot create startup thread: %d", result);
+		}
+		thread_deallocate(thread);
+	}
+	return true;
+}
+
+void
+NabuCPU::startAll(void *arg __unused, wait_result_t result __unused)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	uint32_t requested = topology->num_cpus;
+	PE_parse_boot_argn("cpus", &requested, sizeof(requested));
+	IOLog("NABU CPU: requested=%u selected=%u\n", requested, topology->num_cpus);
+
+	uint64_t deadline;
+	nanoseconds_to_deadline(10 * NSEC_PER_SEC, &deadline);
+	while (__atomic_load_n(&nabu_cpus_registered, __ATOMIC_ACQUIRE) != topology->num_cpus) {
+		if (mach_absolute_time() > deadline) {
+			panic("NABU CPU: device-tree CPU nub registration timed out (%u/%u)",
+			    __atomic_load_n(&nabu_cpus_registered, __ATOMIC_ACQUIRE), topology->num_cpus);
+		}
+		IOSleep(1);
+	}
+	if (topology->boot_cpu == NULL) {
+		panic("NABU CPU: device tree did not identify the boot CPU");
+	}
+	ml_set_max_cpus(topology->max_cpu_id + 1);
+
+	for (unsigned int phase = 0; phase < topology->num_cpus; phase++) {
+		unsigned int boot_id = topology->boot_cpu->cpu_id;
+		unsigned int cpu_id = phase == 0 ? boot_id :
+		    (phase <= boot_id ? phase - 1 : phase);
+		NabuCPU *cpu = __atomic_load_n(&nabu_cpus[cpu_id], __ATOMIC_ACQUIRE);
+		if (cpu == NULL) {
+			panic("NABU CPU: missing nub for logical CPU %u", cpu_id);
+		}
+		kern_return_t kr = processor_start(cpu->machProcessor);
+		if (kr != KERN_SUCCESS) {
+			panic("NABU CPU: processor_start cpu=%u failed: %d", cpu_id, kr);
+		}
+		nanoseconds_to_deadline(5 * NSEC_PER_SEC, &deadline);
+		while (__atomic_load_n(&cpu->nabuStarted, __ATOMIC_ACQUIRE) == 0 ||
+		    !nabu_cpu_signal_is_enabled(cpu_id)) {
+			if (mach_absolute_time() > deadline) {
+				panic("NABU CPU: cpu=%u MPIDR=0x%x failed PSCI/reset/GIC/SGI startup",
+				    cpu_id, topology->cpus[cpu_id].phys_id);
+			}
+			IOSleep(1);
+		}
+		IOLog("NABU CPU: cpu=%u MPIDR=0x%x online; SGI1 OK\n",
+		    cpu_id, topology->cpus[cpu_id].phys_id);
+	}
+
+	ml_cpu_init_completed();
+	__atomic_load_n(&nabu_cpus[topology->boot_cpu->cpu_id], __ATOMIC_ACQUIRE)->cpusRunning();
+	IOService::publishResource(gIOAllCPUInitializedKey, kOSBooleanTrue);
+	IOLog("NABU CPU: %u/%u processors initialized\n", topology->num_cpus, topology->num_cpus);
+	thread_terminate(current_thread());
+}
+
+void
+NabuCPU::free(void)
+{
+	OSSafeReleaseNULL(cpuName);
+	IOCPU::free();
+}
+
+void
+NabuCPU::initCPU(bool boot)
+{
+	if (!boot) {
+		panic("NABU CPU: CPU resume is not implemented");
+	}
+	assert(cpu_number() == (int)getCPUNumber());
+	ml_broadcast_cpu_event(CPU_BOOTED, getCPUNumber());
+	signalCPU(this);
+	setCPUState(kIOCPUStateRunning);
+	__atomic_store_n(&nabuStarted, 1, __ATOMIC_RELEASE);
+}
+
+void
+NabuCPU::signalCPU(IOCPU *target)
+{
+	if (target == NULL) {
+		panic("NABU CPU: null SGI target");
+	}
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	unsigned int logical = target->getCPUNumber();
+	if (logical >= topology->num_cpus) {
+		panic("NABU CPU: invalid SGI target %u", logical);
+	}
+	uint64_t mpidr = topology->cpus[logical].phys_id;
+	unsigned int aff0 = (unsigned int)(mpidr & 0xff);
+	if (aff0 >= 16) {
+		panic("NABU CPU: SGI target requires unsupported range selector");
+	}
+	uint64_t sgi = (((mpidr >> 32) & 0xff) << 48) |
+	    (((mpidr >> 16) & 0xff) << 32) |
+	    (((mpidr >> 8) & 0xff) << 16) |
+	    ((uint64_t)NABU_IPI_SGI << 24) | (1ULL << aff0);
+	__builtin_arm_dsb(kNabuDSB_ISHST);
+	__builtin_arm_wsr64("ICC_SGI1R_EL1", sgi);
+	__builtin_arm_isb(kNabuISB_SY);
+}
+
+kern_return_t
+NabuCPU::startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	const ml_topology_cpu_t *cpu = &topology->cpus[getCPUNumber()];
+	if (start_paddr != 0 || arg_paddr != 0 || cpu == topology->boot_cpu ||
+	    __atomic_load_n(&nabuStarted, __ATOMIC_ACQUIRE) != 0) {
+		panic("NABU CPU: unsupported restart of cpu=%u", getCPUNumber());
+	}
+	vm_offset_t entry = ml_static_vtop((vm_offset_t)&nabu_secondary_entry);
+	IOLog("NABU CPU: PSCI CPU_ON cpu=%u MPIDR=0x%x entry=0x%llx\n",
+	    getCPUNumber(), cpu->phys_id, (uint64_t)entry);
+	__builtin_arm_dsb(kNabuDSB_SY);
+	int32_t rc = nabu_psci_cpu_on(cpu->phys_id, entry, getCPUNumber());
+	if (rc != 0) {
+		panic("NABU CPU: PSCI CPU_ON cpu=%u returned %d", getCPUNumber(), rc);
+	}
+	return KERN_SUCCESS;
+}
+
+void
+NabuCPU::quiesceCPU(void)
+{
+	panic("NABU CPU: platform quiesce is not implemented");
+}
+
+void
+NabuCPU::haltCPU(void)
+{
+	panic("NABU CPU: PSCI CPU_OFF is not implemented");
+}
+
+const OSSymbol *
+NabuCPU::getCPUName(void)
+{
+	return cpuName;
+}
+#endif /* NABU */
diff --git a/iokit/Kernel/arm/NabuPlatformExpert.cpp b/iokit/Kernel/arm/NabuPlatformExpert.cpp
