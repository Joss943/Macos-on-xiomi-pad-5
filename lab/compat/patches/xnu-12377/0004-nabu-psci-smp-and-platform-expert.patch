 void
 cpu_timebase_init(boolean_t from_boot)
 {
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index 07143d53..f9d4cb25 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -1154,6 +1154,16 @@ ml_parse_cpu_topology(void)
 	const boolean_t cpus_boot_arg_present = PE_parse_boot_argn("cpus", &cpu_boot_arg, sizeof(cpu_boot_arg));
 	const boolean_t cpumask_boot_arg_present = PE_parse_boot_argn("cpumask", &cpumask_boot_arg, sizeof(cpumask_boot_arg));
 
+#if defined(NABU)
+	/* SM8150 exposes eight Kryo 485 cores; never index beyond the device's CPU table. */
+	if (cpu_boot_arg == 0) {
+		cpu_boot_arg = 1;
+	}
+	if (cpu_boot_arg > NABU_SMP_MAX_CPUS) {
+		cpu_boot_arg = NABU_SMP_MAX_CPUS;
+	}
+#endif
+
 	// The cpus=N and cpumask=N boot args cannot be used simultaneously. Flag this
 	// so that we trigger a panic later in the boot process, once serial is enabled.
 	if (cpus_boot_arg_present && cpumask_boot_arg_present) {
@@ -1237,6 +1247,20 @@ ml_parse_cpu_topology(void)
 			cpu->cluster_type = CLUSTER_TYPE_P;
 		}
 
+#if defined(NABU)
+		/* Linux's SM8150 DT gives 488 DMIPS/MHz for A55s and 1024 for A76s. */
+		if (cluster_type == 0) {
+			uint32_t capacity = (uint32_t)ml_readprop(child, "capacity-dmips-mhz", 0);
+			if (cpu->phys_id == 0x700) {
+				cpu->cluster_type = CLUSTER_TYPE_P;
+			} else if (capacity != 0 && capacity <= 512) {
+				cpu->cluster_type = CLUSTER_TYPE_E;
+			} else if (capacity != 0) {
+				cpu->cluster_type = CLUSTER_TYPE_M;
+			}
+		}
+#endif
+
 		if (ml_readprop(child, "cluster-power-down", 0)) {
 			topology_info.cluster_power_down = 1;
 		}
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 12974cea..99f5a8e7 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -295,6 +295,48 @@ LEXT(LowExceptionVectorBase)
 LEXT(bootstrap_instructions)
 
 #endif /* defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR) || defined(KERNEL_INTEGRITY_PV_CTRR) */
+#if defined(NABU)
+/* PSCI CPU_ON enters here in the highest non-secure EL with caches/MMU off. */
+	.align 2
+	.globl EXT(nabu_secondary_entry)
+LEXT(nabu_secondary_entry)
+	msr		DAIFSet, #0xf
+	mrs		x1, CurrentEL
+	cmp		x1, #0x4
+	b.eq	Lnabu_secondary_el1
+	cmp		x1, #0x8
+	b.ne	Lnabu_secondary_bad_el
+	adrp	x1, EXT(LowExceptionVectorBase)@page
+	add		x1, x1, EXT(LowExceptionVectorBase)@pageoff
+	msr		VBAR_EL2, x1
+	/* Drop to non-secure EL1; do not inherit hypervisor traps or stale timer offset. */
+	MOV64	x1, 0x80000000
+	msr		HCR_EL2, x1
+	msr		VTTBR_EL2, xzr
+	msr		CPTR_EL2, xzr
+	msr		MDCR_EL2, xzr
+	mov		x1, #3
+	msr		CNTHCTL_EL2, x1
+	msr		CNTVOFF_EL2, xzr
+	mrs		x1, ICC_SRE_EL2
+	orr		x1, x1, #9
+	msr		ICC_SRE_EL2, x1
+	MOV64	x1, 0x30d00800
+	msr		SCTLR_EL1, x1
+	isb
+	adrp	x1, Lnabu_secondary_el1@page
+	add		x1, x1, Lnabu_secondary_el1@pageoff
+	msr		ELR_EL2, x1
+	mov		x1, #0x3c5
+	msr		SPSR_EL2, x1
+	eret
+Lnabu_secondary_bad_el:
+	b		.
+Lnabu_secondary_el1:
+	msr		SPSel, #1
+	b		EXT(LowResetVectorBase)
+#endif /* NABU */
+
 	.align 2
 	.globl EXT(resume_idle_cpu)
 LEXT(resume_idle_cpu)
diff --git a/pexpert/pexpert/arm64/NABU.h b/pexpert/pexpert/arm64/NABU.h
index b82ebe65..193638ac 100644
--- a/pexpert/pexpert/arm64/NABU.h
+++ b/pexpert/pexpert/arm64/NABU.h
@@ -9,6 +9,7 @@
 
 #define NO_MONITOR                   1
 #define NABU                         1
+#define NABU_SMP_MAX_CPUS            8
 #define HAS_CLUSTER                  1
 #define __ARM_AMP__                  1
 #define HAS_GIC_V3                   1
