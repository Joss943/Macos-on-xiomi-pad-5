diff --git a/pexpert/pexpert/arm64/NABU.h b/pexpert/pexpert/arm64/NABU.h
new file mode 100644
index 00000000..b82ebe65
--- /dev/null
+++ b/pexpert/pexpert/arm64/NABU.h
@@ -0,0 +1,82 @@
+/*
+ * Xiaomi Pad 5 (nabu / SM8150-AC) generic ARM64 board configuration.
+ * Qualcomm's Cortex-A76/A55 based Kryo cores expose 64-byte cache lines and
+ * the platform provides a GICv3 with Group 0 reserved by TrustZone.
+ */
+
+#ifndef _PEXPERT_ARM64_NABU_H
+#define _PEXPERT_ARM64_NABU_H
+
+#define NO_MONITOR                   1
+#define NABU                         1
+#define HAS_CLUSTER                  1
+#define __ARM_AMP__                  1
+#define HAS_GIC_V3                   1
+#define ARM_ARCH_TIMER               1
+
+#define __ARM_ARCH__                 8
+#define __ARM_VMSA__                 8
+#define __ARM_VFP__                  4
+#define __ARM_COHERENT_CACHE__       1
+#define __ARM_DEBUG__                7
+#define __ARM_ENABLE_SWAP__          1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#define __ARM_PAN_AVAILABLE__        1
+#define __ARM_16K_PG__               1
+
+/*
+ * Kryo 485 (Cortex-A76/A55) implements ARMv8.2-A: LSE atomics, UAO and FP16.
+ * XNU keys CAS-based atomics (required by sched_clutch.c), UAO save/restore
+ * and FP16 reporting on this macro, which Apple's compiler does not predefine
+ * for -march=armv8.2-a. Nothing newer (8.3 PAC, 8.4 DIT/TLBI range) is set.
+ */
+#ifndef __ARM_ARCH_8_2__
+#define __ARM_ARCH_8_2__             1
+#endif
+
+/* Linux reports the architected virtual timer as PDC-GIC INTID 19 on nabu. */
+#define NABU_VTIMER_INTID            19
+#define NABU_IPI_SGI                 1
+
+#define GIC_SPURIOUS_IRQ             1023
+#define GICR_PE_SIZE                 0x20000
+
+#define GICD_CTLR                    0x0
+#define GICD_CTLR_ENABLEGRP1_NS      0x2
+#define GICD_CTLR_ARE_NS             0x10
+#define GICD_CTLR_RWP                0x80000000
+
+#define GICR_TYPER                   0x08
+#define GICR_WAKER                   0x14
+#define GICR_IGROUPR0                0x10080
+#define GICR_ISENABLER0              0x10100
+#define GICR_IPRIORITYR0             0x10400
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT 32
+#define GICR_TYPER_LAST              0x10
+#define GICR_WAKER_PROCESSORSLEEP    0x2
+#define GICR_WAKER_CHILDRENASLEEP    0x4
+
+#define ICC_CTLR_EOIMODE             0x2
+#define ICC_SRE_SRE                  0x1
+
+/*
+ * apple_arm64_cpu.h names Apple's MPIDR core-type field. Kryo 485 has no such
+ * field: bits 16..18 are Aff2, which is 0 on SM8150, so arm64_core_type()
+ * would report E_CORE on every CPU. Nothing built for nabu may rely on it;
+ * these values only let the shared header compile.
+ */
+#define MPIDR_CORETYPE_SHIFT         (16)
+#define MPIDR_CORETYPE_WIDTH         (3)
+#define MPIDR_CORETYPE_MASK          ((1ULL << MPIDR_CORETYPE_WIDTH) - 1)
+#define MPIDR_CORETYPE_ACC_E         (0ULL)
+#define MPIDR_CORETYPE_ACC_P         (1ULL)
+#define MPIDR_CORETYPE_ACC_M         (4ULL)
+
+/* SM8150 reports MPIDR Aff1 values 0..7 for the eight Kryo 485 CPUs. */
+#define NABU_MAX_PHYSICAL_CLUSTER_ID 7
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif
+
+#endif /* _PEXPERT_ARM64_NABU_H */
