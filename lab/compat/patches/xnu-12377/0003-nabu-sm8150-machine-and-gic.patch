diff --git a/osfmk/arm64/nabu_platform_stubs.c b/osfmk/arm64/nabu_platform_stubs.c
new file mode 100644
index 00000000..0d3281e4
--- /dev/null
+++ b/osfmk/arm64/nabu_platform_stubs.c
@@ -0,0 +1,46 @@
+/*
+ * NABU (Xiaomi Pad 5, SM8150) replacements for routines Apple ships only in
+ * the unpublished per-SoC kernel archive. Each one is the behaviour a
+ * non-Apple ARMv8.2 core without PPL needs; none touches an Apple register.
+ */
+#if defined(ARM64_BOARD_CONFIG_NABU)
+
+#include <kern/ast.h>
+#include <arm/machine_routines.h>
+#include <arm/pmap.h>
+
+extern void CleanPoC_DcacheRegion_Force(vm_offset_t va, size_t length);
+
+/* "nohid": the Apple variant skips a HID-register workaround. Kryo has none. */
+void
+CleanPoC_DcacheRegion_Force_nopreempt_nohid(vm_offset_t va, size_t length)
+{
+	CleanPoC_DcacheRegion_Force(va, length);
+}
+
+/* No Apple fuses; report a production part so no engineering-sample paths run. */
+boolean_t
+ml_device_is_prod_fused(void)
+{
+	return TRUE;
+}
+
+/* The monitor is the PPL, which nabu does not have (XNU_MONITOR is 0). */
+void
+ml_enable_monitor(void)
+{
+}
+
+#if SCHED_HYGIENE_DEBUG && (DEBUG || DEVELOPMENT)
+/* Apple's version also records scheduler-hygiene data; the AST check is the contract. */
+#undef pmap_pending_preemption
+bool
+pmap_pending_preemption(void)
+{
+	return _pmap_pending_preemption_real();
+}
+#endif
+
+#else
+extern int nabu_platform_stubs_unused;
+#endif /* ARM64_BOARD_CONFIG_NABU */
