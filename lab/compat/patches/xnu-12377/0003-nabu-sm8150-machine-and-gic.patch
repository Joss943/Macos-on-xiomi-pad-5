diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index d6b051b0..7f501a87 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -29,6 +29,7 @@
 #include <arm/caches_internal.h>
 #include <arm/cpu_data.h>
 #include <arm/cpu_data_internal.h>
+#include <arm/machine_cpu.h>
 #include <arm/misc_protos.h>
 #include <arm/thread.h>
 #include <arm/rtclock.h>
@@ -3111,6 +3112,45 @@ sleh_irq(arm_saved_state_t *state)
 #endif
 
 
+#if defined(NABU)
+	/*
+	 * Qualcomm TrustZone owns GIC Group 0. The tablet's non-secure timer,
+	 * IPIs and device interrupts arrive through Group 1 / IRQ.
+	 */
+	uint64_t iar = __builtin_arm_rsr64("ICC_IAR1_EL1");
+	uint32_t intid = (uint32_t)(iar & 0xFFFFFF);
+
+	if (intid >= 1020) {
+		/* No EOI for a spurious ID, but still unwind the XNU IRQ prologue. */
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_OTHER);
+		goto nabu_irq_epilogue;
+	}
+
+	if (intid == NABU_VTIMER_INTID) {
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_TIMER);
+		cdp->cpu_decrementer = -1;
+		ml_interrupt_masked_debug_start(rtclock_intr, DBG_INTR_TYPE_TIMER);
+		rtclock_intr(TRUE);
+		ml_interrupt_masked_debug_end();
+		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+	} else if (intid == NABU_IPI_SGI) {
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_IPI);
+		/* Retire the SGI before draining pending cross-CPU work. */
+		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+		__builtin_arm_isb(ISB_SY);
+		cpu_signal_handler();
+	} else {
+		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_OTHER);
+		if (cdp->interrupt_handler) {
+			cdp->interrupt_handler(cdp->interrupt_target,
+			    cdp->interrupt_refCon,
+			    cdp->interrupt_nub,
+			    intid);
+		}
+		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+	}
+	__builtin_arm_isb(ISB_SY);
+#else
 	sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_OTHER);
 
 #if USE_APPLEARMSMP
@@ -3122,10 +3162,14 @@ sleh_irq(arm_saved_state_t *state)
 	    cdp->interrupt_nub,
 	    cdp->interrupt_source);
 #endif
+#endif /* NABU */
 
 	entropy_collect();
 
 
+#if defined(NABU)
+nabu_irq_epilogue:
+#endif /* NABU */
 	sleh_interrupt_handler_epilogue();
 #if MACH_ASSERT
 	if (preemption_level != sleh_get_preemption_level()) {
