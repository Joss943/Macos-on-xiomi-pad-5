diff --git a/libkern/os/firehose_nabu.c b/libkern/os/firehose_nabu.c
new file mode 100644
index 00000000..e81b14aa
--- /dev/null
+++ b/libkern/os/firehose_nabu.c
@@ -0,0 +1,63 @@
+/*
+ * Minimal kernel firehose for NABU (Xiaomi Pad 5, SM8150).
+ *
+ * The SDK and KDK ship libfirehose_kernel.a only as x86_64 and arm64e.kernel,
+ * and NABU links a plain arm64 kernel. Until the Apache-2.0 libdispatch
+ * firehose_buffer.c is ported, this replacement keeps os_log on the early
+ * boot chunk in libkern/os/log.c: reserve fails, so log.c falls back to
+ * firehose_boot_chunk and then counts dropped messages. printf/kprintf to the
+ * serial console are unaffected. logd gets an empty buffer.
+ */
+#if defined(ARM64_BOARD_CONFIG_NABU)
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <mach/vm_types.h>
+#include <firehose/firehose_types_private.h>
+#include <firehose/tracepoint_private.h>
+#include <firehose/chunk_private.h>
+#include <os/firehose_buffer_private.h>
+
+extern vm_offset_t kernel_firehose_addr;
+
+firehose_tracepoint_t
+__firehose_buffer_tracepoint_reserve(uint64_t stamp, firehose_stream_t stream,
+    uint16_t pubsize, uint16_t privsize, uint8_t **privptr)
+{
+	(void)stamp; (void)stream; (void)pubsize; (void)privsize; (void)privptr;
+	return NULL;
+}
+
+void
+__firehose_buffer_tracepoint_flush(firehose_tracepoint_t ft, firehose_tracepoint_id_u ftid)
+{
+	(void)ft; (void)ftid;
+}
+
+firehose_buffer_t
+__firehose_buffer_create(size_t *size)
+{
+	(void)size;
+	/* Keep the zeroed buffer subr_log.c allocated so LOGBUFFERMAP stays valid. */
+	return (firehose_buffer_t)kernel_firehose_addr;
+}
+
+bool
+__firehose_merge_updates(firehose_push_reply_t update)
+{
+	(void)update;
+	return false;
+}
+
+int
+__firehose_kernel_configuration_valid(uint8_t chunk_count, uint8_t io_pages)
+{
+	(void)chunk_count; (void)io_pages;
+	return 1;
+}
+
+#else
+/* Other configurations link Apple's libfirehose_kernel. */
+extern int firehose_nabu_unused;
+#endif /* ARM64_BOARD_CONFIG_NABU */
