From: nabu port
Subject: [PATCH 0006] nabu: link the arm64 kernel with -add_split_seg_info -kernel

NABU keeps ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG=arm64 (0003), so the
LDFLAGS_KERNEL_ONLY_SUBARCH_arm64e/x86_64 rules never reach its final kernel
link. XnuPrelink needs both of their effects to place kernel.development.nabu
in a kernel collection:
  -add_split_seg_info  LC_SEGMENT_SPLIT_INFO (verified in run 22)
  -kernel              kernel-cache chained fixups; without it ld emitted
                       115805 classic local relocations and no
                       LC_DYLD_CHAINED_FIXUPS (run 22)
Only CURRENT_MACHINE_CONFIG=NABU is affected.
---
diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 87e1824..20f552e 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -1131,6 +1131,18 @@ LDFLAGS_KERNEL_ONLY_SUBARCH_x86_64 = \
 	-Wl,-kernel
 LDFLAGS_KERNEL_ONLY_SUBARCH_x86_64h = $(LDFLAGS_KERNEL_ONLY_SUBARCH_x86_64)
 
+# NABU links plain arm64 (ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG stays arm64,
+# see 0003), so neither SUBARCH rule above applies to it. Use the same kernel
+# link flags: split-segment info lets the kernel be relocated into a kernel
+# collection, and -kernel makes ld emit kernel-cache chained fixups instead of
+# classic local relocations. Scoped to NABU: every other arm64 config builds
+# as arm64e and is unchanged.
+ifeq ($(CURRENT_MACHINE_CONFIG),NABU)
+LDFLAGS_KERNEL_ONLY_SUBARCH_arm64 = \
+	-Wl,-add_split_seg_info \
+	-Wl,-kernel
+endif
+
 LDFLAGS_KERNEL	= $(LDFLAGS_KERNEL_GEN) \
 		  $(LDFLAGS_KERNEL_SDK) \
 		  $($(addsuffix $(CURRENT_ARCH_CONFIG),ARCH_FLAGS_)) \
