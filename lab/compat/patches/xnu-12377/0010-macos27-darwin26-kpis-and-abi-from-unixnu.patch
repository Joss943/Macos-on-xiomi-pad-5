+/*
+ * macOS 27: a coprocessor message through the handle its registration returned
+ * (the first 16 bits are the coprocessor's id). This kernel keeps one
+ * coprocessor message path, so the message goes the way os_log_coprocessor
+ * sends it, without the per-coprocessor id.
+ */
+bool os_log_coprocessor_with_handle(const uint16_t *handle, void *buff, uint64_t buff_len, os_log_type_t type,
+    const char *uuid, uint64_t timestamp, uint32_t offset, bool stream_log);
+bool
+os_log_coprocessor_with_handle(__unused const uint16_t *handle, void *buff, uint64_t buff_len, os_log_type_t type,
+    const char *uuid, uint64_t timestamp, uint32_t offset, bool stream_log)
+{
+	return os_log_coprocessor(buff, buff_len, type, uuid, timestamp, offset, stream_log);
+}
+
+/*
+ * macOS 27: a coprocessor metric record for the Darwin 26 metrics stream,
+ * which this kernel does not have. The record is not logged; the call returns
+ * false, as os_log_coprocessor does for a message it does not log.
+ */
+bool os_metric_coprocessor(const void *handle, const void *metric, const void *values, uint64_t a, uint64_t b,
+    uint64_t c, uint64_t d, uint64_t e);
+bool
+os_metric_coprocessor(__unused const void *handle, __unused const void *metric, __unused const void *values,
+    __unused uint64_t a, __unused uint64_t b, __unused uint64_t c, __unused uint64_t d, __unused uint64_t e)
