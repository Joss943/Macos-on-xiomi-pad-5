+{
+	if (cdhash->length == CS_CDHASH_LEN) {
+		set_compilation_service_cdhash(cdhash->hash);
+	}
+}
+
+bool
+match_compilation_service_cdhash_ext(
+	const cs_cdhash_ext_t *cdhash)
+{
+	return cdhash->length == CS_CDHASH_LEN && match_compilation_service_cdhash(cdhash->hash);
+}
+
+void
+unrestrict_local_signing_cdhash_ext(
+	const cs_cdhash_ext_t *cdhash)
+{
+	if (cdhash->length == CS_CDHASH_LEN) {
+		unrestrict_local_signing_cdhash(cdhash->hash);
+	}
+}
+
+/*
+ * macOS 27 names these three calls *_with_length; they take the same 64-byte
+ * cdhash and its length (at +0x40) as the iPadOS 27 *_ext calls above.
+ */
+void
+set_compilation_service_cdhash_with_length(
+	const cs_cdhash_ext_t *cdhash)
+{
+	set_compilation_service_cdhash_ext(cdhash);
+}
+
+bool
+match_compilation_service_cdhash_with_length(
+	const cs_cdhash_ext_t *cdhash)
+{
+	return match_compilation_service_cdhash_ext(cdhash);
+}
+
+void
+unrestrict_local_signing_cdhash_with_length(
+	const cs_cdhash_ext_t *cdhash)
